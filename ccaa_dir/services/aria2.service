[Unit]
Description=aria2
After=network.target

[Service]
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/bin/bash /etc/ccaa/upbt.sh --pre-start
ExecStart=/usr/bin/sudo -u ccaa /usr/bin/env aria2c --conf-path=/etc/ccaa/aria2.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
